    "@hono/node-server": "2.0.4",
    "@segment/analytics-node": "1.3.0",
    "add-mcp": "2.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chalk": "5.3.0",
    "chokidar": "5.0.0",
    "cliui": "8.0.1",
    "diff": "5.2.0",
    "execa": "^9.5.2",
    "fflate": "^0.8.3",
    "jsonc-parser": "3.3.1",
    "open": "^10.2.0",
    "openid-client": "6.8.1",
    "pg": "^8.20.0",
    "pg-connection-string": "^2.14.1",
    "pg-format": "1.0.4",
    "pg-protocol": "^1.14.0",
    "picocolors": "^1.1.1",
