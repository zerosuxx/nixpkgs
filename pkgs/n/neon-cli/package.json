    "ws": "^8.21.2",
    "yaml": "^2.9.0",
    "yargs": "17.7.2",
    "yoctocolors": "^2.1.2",
    "@neon/config-runtime": "1.12.5",
    "@neon/realtime": "0.2.1",
    "@neon/sdk": "7.14.0",
    "@neon/config": "1.14.2"
