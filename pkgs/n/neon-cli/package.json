{
  "name": "neon",
  "version": "9.6.0",
  "description": "CLI tool for Neon, the cloud backend primitives built around Lakebase Postgres",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neondatabase/neon-pkgs.git"
  },
  "files": [
    "README.md",
    "dist/",
    "package.json"
  ],
  "bin": {
    "neon": "dist/cli.js"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js",
    "./dist/_shared/*": null,
    "./dist/_chunks/*": null,
    "./dist/_virtual/*": null,
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@clack/core": "0.4.2",
